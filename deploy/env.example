# reviewbot orchestrator settings, read by the systemd user unit.
# README.md, section "Configuration", lists every variable with its default.

# The Claude token from `claude setup-token`. This file holds it, so it must
# be mode 0600.
CLAUDE_CODE_OAUTH_TOKEN=

# The GitHub App. reviewbot reviews every repository of every installation
# of the App.
REVIEWBOT_APP_ID=
REVIEWBOT_APP_PRIVATE_KEY_PATH=

# REVIEWBOT_POLL_SECONDS=180
# REVIEWBOT_MAX_REVIEWS_PER_HOUR=6
# Prefix of the docker image, network and container names; lets a second
# instance run beside this one.
# REVIEWBOT_DOCKER_PREFIX=reviewbot
# A file of review instructions that replaces the image's reviewer/review.md
# (README.md, "Customizing the review").
# REVIEWBOT_PROMPT_FILE=
# 1 prints reviews to the journal instead of posting them
REVIEWBOT_DRY_RUN=1
