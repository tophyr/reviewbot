# Values the orchestrator, its scripts and its containers must agree on.
# config.py reads this file. deploy/build-images.sh, the e2e scripts and the
# reviewer and fetcher entrypoints source it; the images hold it at
# /opt/reviewbot/contract.env. Every line other than a comment or a blank
# line is NAME='value' with no ' in the value, so the shell and config.py
# read the same values; config.py refuses any other line.

# Docker name prefix (REVIEWBOT_DOCKER_PREFIX), checked by config.py and
# build-images.sh.
DOCKER_PREFIX_RE='[a-z][a-z0-9-]{0,31}'

# The reviewer's model and turn limit: the defaults config.py uses when
# REVIEWBOT_MODEL and REVIEWBOT_MAX_TURNS are unset, and the values both
# config.py and the reviewer entrypoint accept.
DEFAULT_MODEL='opus'
MODEL_RE='[A-Za-z0-9][]A-Za-z0-9._:@[-]{0,99}'
DEFAULT_MAX_TURNS='500'
MAX_TURNS_LIMIT='9999'

# Seconds a reviewer run may take.
REVIEW_TIMEOUT='1200'

# The fetcher's /scratch tmpfs in MiB, its inodes per MiB, and its /log tmpfs
# in MiB.
MAX_FETCH_MB='10240'
FETCH_INODES_PER_MB='256'
LOG_TMPFS_MB='16'

# Fetcher exit statuses: the repository does not fit in /scratch, and
# github.com's git endpoint is unreachable.
FETCHER_EXIT_TOO_LARGE='74'
FETCHER_EXIT_GIT_UNREACHABLE='75'
